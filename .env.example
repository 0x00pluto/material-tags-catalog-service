# 素材盘根目录（必填）
CATALOG_ROOT=/path/to/media-library

# 输出 JSONL；默认 <CATALOG_ROOT>/material-tags-catalog.jsonl
# CATALOG_OUT=

# HTTP（默认仅本机；局域网访问改为 HOST=0.0.0.0，并放行防火墙端口）
HOST=127.0.0.1
PORT=8787

# Watch
WATCH_ENABLED=true
WATCH_DEBOUNCE_SEC=2

# 定时全量兜底（秒）
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL_SEC=600

# 扫描排除：逗号分隔目录名；相对 root 任一路径段精确匹配则跳过该子树（空=不排除）
# 示例：SCAN_EXCLUDE_DIR_NAMES=000-回收站
# SCAN_EXCLUDE_DIR_NAMES=

# 合法 orphan（校验通过但无原媒体）是否物理删除 *.material-tags.json（默认 true）
# 只读盘 / 联调可设 false，回退为仅 skip 不删文件
# PURGE_ORPHAN_TAGS=true

# 可选；空=不鉴权（仅建议内网）
# API_KEY=
